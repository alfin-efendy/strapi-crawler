{
  "type": "node",
  "request": "launch",
  "name": "Launch via pnpm",
  "runtimeExecutable": "pnpm",
  "runtimeArgs": [
    "run-script",
    "dev"
  ],
  "port": 9229,
  "skipFiles": [
    "<node_internals>/**"
  ],
  "console": "integratedTerminal",
  "env": {
    "NODE_ENV": "development",
  }
}